{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laya",
  "main": "../shared/worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "ORDERS",
      "id": "92d9752349614977bdc0e8e37dc88b6b"
    }
  ]
}
