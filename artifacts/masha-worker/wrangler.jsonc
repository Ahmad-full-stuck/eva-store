{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masha-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../masha-store/dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "masha-store-db",
      "database_id": "TO_BE_FILLED_AT_DEPLOY"
    }
  ],
  "vars": {
    "STORE_ORIGIN": "https://ahmad-full-stuck.github.io"
  }
}
