{
  "name": "@workspace/masha-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:create": "wrangler d1 create masha-store-db",
    "db:migrate:local": "wrangler d1 migrations apply masha-store-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply masha-store-db --remote",
    "db:provision": "node scripts/ensure-db.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "typescript": "~5.9.3",
    "wrangler": "4.147.0"
  }
}
