{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "zaytoun-group-storefront-demo-2026",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
