{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamha-iq",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../eva-fabrics-store/dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lamha-eva-store-db",
      "database_id": "dca827a4-c6e5-44f4-b71e-3ebfb9e3ee92"
    }
  ],
  "vars": {
    "STORE_ORIGIN": "https://lamha-iq.eva-store.workers.dev",
    "VAPID_PUBLIC_KEY": "BGx1_hVRVRmzwNYUzzH8P7H6TG4zeyIee3wtvKTaI6e7j1cXDqW7oEAY_4NQ8eUyeuzzNVVojwac17lShdmVMHk",
    "VAPID_SUBJECT": "mailto:admin@lamha-iq.pages.dev"
  }
}
