{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamha-iq",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../eva-fabrics-store/dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lamha-store-db",
      "database_id": "REPLACE_WITH_LAMHA_DB_ID"
    }
  ],
  "vars": {
    "STORE_ORIGIN": "https://lamha-iq.pages.dev",
