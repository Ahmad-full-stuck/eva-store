{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "g",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "../eva-fabrics-store/dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scoop-shop",
      "database_id": "90bdb0e5-5f2f-4099-839c-9d9144d75224",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "STORE_ORIGIN": "https://g.eva-store.workers.dev"
  }
}
